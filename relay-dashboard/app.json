{
  "$schema": "https://schema.native-sdk.dev/app/v1.json",
  "id": "sh.relay.dashboard",
  "name": "relay-dashboard",
  "display_name": "Relay",
  "description": "Dashboard for Relay pipeline runs across your repos.",
  "version": "0.1.0",
  "icons": ["assets/icon.png"],
  "platforms": ["macos"],
  "permissions": ["view", "command", "filesystem", "clipboard", "reveal_path"],
  "capabilities": ["native_views", "gpu_surfaces", "menus", "clipboard", "reveal_path"],
  "dock_visible": true,
  "service_carrier": "child",
  "menus": [
    {
      "title": "Dashboard",
      "items": [
        { "label": "Settings…", "command": "app.settings", "key": ",", "modifiers": ["primary"] },
        { "separator": true },
        { "label": "New Feature", "command": "app.new_run", "key": "n", "modifiers": ["primary"] },
        { "label": "Refresh", "command": "app.refresh", "key": "r", "modifiers": ["primary"] }
      ]
    },
    {
      "title": "Window",
      "items": [
        { "label": "Dashboard", "command": "app.open_dashboard", "key": "0", "modifiers": ["primary"] },
        { "label": "Close Window", "command": "app.close_window", "key": "w", "modifiers": ["primary"] }
      ]
    }
  ],
  "shell": {
    "windows": [
      {
        "label": "main",
        "title": "Relay",
        "width": 640,
        "height": 560,
        "initially_hidden": false,
        "close_policy": "hide",
        "views": [
          { "label": "main-canvas", "kind": "gpu_surface", "fill": true, "role": "Dashboard canvas", "accessibility_label": "Relay dashboard", "gpu_backend": "metal", "gpu_pixel_format": "bgra8_unorm", "gpu_present_mode": "timer", "gpu_alpha_mode": "opaque", "gpu_color_space": "srgb", "gpu_vsync": true }
        ]
      }
    ]
  },
  "security": {
    "navigation": {
      "allowed_origins": ["zero://app", "zero://inline"],
      "external_links": { "action": "deny" }
    }
  },
  "web_engine": "system",
  "cef": { "dir": "third_party/cef/macos", "auto_install": false }
}
